# Network Selection: PONTUSXDEV, PONTUSXTEST, or OP_SEPOLIA
NETWORK=PONTUSXDEV

# Account / Wallet Authentication
# Either set PRIVATE_KEY directly, or use "pontus-x_cli login" with a password-protected keystore file
PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Password referenced in manifest.yaml for the encrypted key file:
UDL_KEY_PASSWORD=your_keystore_password_here

# Ocean Node Component (multi-chain node for metadata, indexer, and provider services)
# Default: https://ocean-node.pontus-x.eu
OCEAN_NODE_URI=https://ocean-node.pontus-x.eu

# Remote Store Configuration for Nautilus v2 Publishing and Editing
# Option 1: Pinata IPFS (recommended)
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional overrides for Pinata:
# PINATA_UPLOAD_URL=https://api.pinata.cloud/pinning/pinFileToIPFS
# PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# Option 2: Custom / Local IPFS (e.g. Kubo node, used if PINATA_JWT is not set)
# IPFS_UPLOAD_URL=http://127.0.0.1:5001/api/v0/add
# IPFS_GATEWAY_URL=http://127.0.0.1:8080

# Blockchain RPC Overrides (Optional)
# OP_SEPOLIA_NODE_URI=https://sepolia.optimism.io
