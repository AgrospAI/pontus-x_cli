{
  "$ref": "#/definitions/PublishConfig",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArweaveFileObject": {
      "additionalProperties": false,
      "properties": {
        "encryptMethod": {
          "$ref": "#/definitions/EncryptMethod"
        },
        "encryptedBy": {
          "type": "string"
        },
        "transactionId": {
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileObjectType"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": ["transactionId", "type"],
      "type": "object"
    },
    "EncryptMethod": {
      "enum": ["AES", "ECIES"],
      "type": "string"
    },
    "ExtendedConsumerParameter": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/definitions/Options"
          },
          "type": "array"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "enum": ["text", "number", "boolean", "select"],
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "label",
        "required",
        "description",
        "default"
      ],
      "type": "object"
    },
    "FileObjectType": {
      "enum": ["url", "ipfs", "arweave", "s3", "ftp"],
      "type": "string"
    },
    "FileTypes": {
      "description": "Storage backends ocean-node can read.\n\nTwo v1 types are gone because ocean-node no longer implements them: `graphql` and `smartcontract`. Three are new: `s3`, `ftp` and the node's own persistent storage.",
      "enum": ["url", "ipfs", "arweave", "s3", "ftp", "nodePersistentStorage"],
      "type": "string"
    },
    "FtpFileObject": {
      "additionalProperties": false,
      "properties": {
        "encryptMethod": {
          "$ref": "#/definitions/EncryptMethod"
        },
        "encryptedBy": {
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileObjectType"
            },
            {
              "type": "string"
            }
          ]
        },
        "url": {
          "description": "Full FTP or FTPS URL: ftp://[user:password@]host[:port]/path or ftps://...",
          "type": "string"
        }
      },
      "required": ["type", "url"],
      "type": "object"
    },
    "HeadersObject": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "IpfsFileObject": {
      "additionalProperties": false,
      "properties": {
        "encryptMethod": {
          "$ref": "#/definitions/EncryptMethod"
        },
        "encryptedBy": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileObjectType"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": ["hash", "type"],
      "type": "object"
    },
    "LanguageValueObject": {
      "additionalProperties": false,
      "properties": {
        "@direction": {
          "type": "string"
        },
        "@language": {
          "type": "string"
        },
        "@value": {
          "type": "string"
        }
      },
      "required": ["@value", "@language", "@direction"],
      "type": "object"
    },
    "MetadataConfig": {
      "additionalProperties": false,
      "properties": {
        "additionalInformation": {
          "type": "object"
        },
        "algorithm": {
          "additionalProperties": false,
          "properties": {
            "consumerParameters": {
              "items": {
                "$ref": "#/definitions/ExtendedConsumerParameter"
              },
              "type": "array"
            },
            "container": {
              "additionalProperties": false,
              "properties": {
                "checksum": {
                  "type": "string"
                },
                "consumerParameters": {
                  "items": {
                    "$ref": "#/definitions/ExtendedConsumerParameter"
                  },
                  "type": "array"
                },
                "entrypoint": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                }
              },
              "required": ["checksum", "entrypoint", "image", "tag"],
              "type": "object"
            },
            "language": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": ["container"],
          "type": "object"
        },
        "attachments": {
          "items": {
            "$ref": "#/definitions/RemoteObject"
          },
          "type": "array"
        },
        "author": {
          "type": "string"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "copyrightHolder": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "type": "string"
        },
        "displayTitle": {
          "$ref": "#/definitions/LanguageValueObject"
        },
        "license": {
          "type": "string"
        },
        "links": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "providedBy": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "type": "string"
        }
      },
      "required": ["description", "name", "type"],
      "type": "object"
    },
    "NftCreateDataWithoutOwner": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "templateIndex": {
          "type": "number"
        },
        "tokenURI": {
          "type": "string"
        },
        "transferable": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "symbol",
        "templateIndex",
        "tokenURI",
        "transferable"
      ],
      "type": "object"
    },
    "Options": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["key", "value"],
      "type": "object"
    },
    "PersistentStorageObject": {
      "additionalProperties": false,
      "properties": {
        "bucketId": {
          "type": "string"
        },
        "encryptMethod": {
          "$ref": "#/definitions/EncryptMethod"
        },
        "encryptedBy": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "type": {
          "const": "nodePersistentStorage",
          "type": "string"
        }
      },
      "required": ["bucketId", "fileName", "type"],
      "type": "object"
    },
    "PublishConfig": {
      "additionalProperties": false,
      "properties": {
        "allowAlgorithmNetworkAccess": {
          "type": "boolean"
        },
        "credentials": {
          "additionalProperties": false,
          "properties": {
            "allow": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "deny": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "metadata": {
          "$ref": "#/definitions/MetadataConfig"
        },
        "nftData": {
          "$ref": "#/definitions/NftCreateDataWithoutOwner"
        },
        "service": {
          "additionalProperties": false,
          "properties": {
            "consumerParameters": {
              "items": {
                "$ref": "#/definitions/ExtendedConsumerParameter"
              },
              "type": "array"
            },
            "datatoken": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "symbol": {
                  "type": "string"
                }
              },
              "required": ["name", "symbol"],
              "type": "object"
            },
            "fileType": {
              "$ref": "#/definitions/FileTypes"
            },
            "files": {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/ServiceFileType%3CFileTypes%3E"
                  },
                  {
                    "$ref": "#/definitions/UrlFileObject"
                  }
                ]
              },
              "type": "array"
            },
            "pricing": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "enum": ["EURAU", "EUROe", "OCEAN", "devEURAU"],
                  "type": "string"
                },
                "type": {
                  "enum": ["fixed", "free"],
                  "type": "string"
                }
              },
              "required": ["type"],
              "type": "object"
            },
            "serviceEndpoint": {
              "type": "string"
            },
            "serviceType": {
              "$ref": "#/definitions/ServiceTypes"
            },
            "timeout": {
              "type": "number"
            }
          },
          "required": [
            "datatoken",
            "files",
            "fileType",
            "pricing",
            "serviceEndpoint",
            "serviceType",
            "timeout"
          ],
          "type": "object"
        },
        "trustOwnerAlgorithms": {
          "type": "boolean"
        },
        "trustedAlgorithmPublishers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "trustedAlgorithms": {
          "items": {
            "$ref": "#/definitions/TrustedAlgorithmAsset"
          },
          "type": "array"
        }
      },
      "required": ["metadata", "nftData", "service"],
      "type": "object"
    },
    "RemoteObject": {
      "additionalProperties": false,
      "properties": {
        "additionalInformation": {
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          },
          "type": "object"
        },
        "description": {
          "$ref": "#/definitions/LanguageValueObject"
        },
        "displayName": {
          "$ref": "#/definitions/LanguageValueObject"
        },
        "fileType": {
          "type": "string"
        },
        "mirrors": {
          "items": {
            "$ref": "#/definitions/RemoteSource"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": ["name", "fileType", "sha256", "mirrors"],
      "type": "object"
    },
    "RemoteSource": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": ["string", "number", "boolean"]
              },
              "type": "object"
            }
          ]
        },
        "ipfsCid": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": ["type"],
      "type": "object"
    },
    "S3FileObject": {
      "additionalProperties": false,
      "properties": {
        "encryptMethod": {
          "$ref": "#/definitions/EncryptMethod"
        },
        "encryptedBy": {
          "type": "string"
        },
        "s3Access": {
          "$ref": "#/definitions/S3Object"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileObjectType"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": ["s3Access", "type"],
      "type": "object"
    },
    "S3Object": {
      "additionalProperties": false,
      "properties": {
        "accessKeyId": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "forcePathStyle": {
          "description": "If true, use path-style addressing (e.g. endpoint/bucket/key). Required for some S3-compatible services (e.g. MinIO). Default false (virtual-host style, e.g. bucket.endpoint/key).",
          "type": "boolean"
        },
        "objectKey": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "secretAccessKey": {
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "objectKey",
        "bucket",
        "accessKeyId",
        "secretAccessKey"
      ],
      "type": "object"
    },
    "ServiceFileType<FileTypes>": {
      "anyOf": [
        {
          "$ref": "#/definitions/IpfsFileObject"
        },
        {
          "$ref": "#/definitions/ArweaveFileObject"
        },
        {
          "$ref": "#/definitions/S3FileObject"
        },
        {
          "$ref": "#/definitions/FtpFileObject"
        },
        {
          "$ref": "#/definitions/PersistentStorageObject"
        },
        {
          "$ref": "#/definitions/UrlFileObject"
        }
      ],
      "description": "Maps a `FileTypes` member onto the ocean.js storage object it needs."
    },
    "ServiceTypes": {
      "enum": ["access", "compute"],
      "type": "string"
    },
    "TrustedAlgorithmAsset": {
      "additionalProperties": false,
      "description": "An algorithm to trust, by DID and (now that v5 requires it) by service.\n\nDDO v5's `PublisherTrustedAlgorithms` carries a required `serviceId`, so nautilus finally resolves one entry per (did, serviceId) pair instead of assuming `services[0]`.",
      "properties": {
        "did": {
          "type": "string"
        },
        "serviceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": ["did"],
      "type": "object"
    },
    "UrlFileObject": {
      "additionalProperties": false,
      "properties": {
        "encryptMethod": {
          "$ref": "#/definitions/EncryptMethod"
        },
        "encryptedBy": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/definitions/HeadersObject"
        },
        "method": {
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileObjectType"
            },
            {
              "type": "string"
            }
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": ["method", "type", "url"],
      "type": "object"
    }
  }
}
